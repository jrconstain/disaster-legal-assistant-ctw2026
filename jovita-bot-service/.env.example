# Jovita
APP_ENV=development
DATA_DIR=./data
CONSENT_MORE_INFO_URL=https://example.com/privacidad

# IA conversacional / extracción
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_DETAIL=low
OPENAI_PDF_DETAIL=high

# WhatsApp Cloud API
GRAPH_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=cambia-esto
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WHATSAPP_DRY_RUN=true

# Generador jurídico hermano
# subprocess = mismo contenedor/repo; http = servicio separado; disabled = solo tests de conversación
LEGAL_DOCS_MODE=subprocess
LEGAL_DOCS_ROOT=../legal-docs-service
LEGAL_DOCS_KNOWLEDGE_PATH=../legal-docs-service/knowledge/knowledgebase_inmuebles_colombia_v0.1.md
LEGAL_DOCS_PROVIDER=mock
LEGAL_DOCS_URL=
LEGAL_DOCS_API_TOKEN=
