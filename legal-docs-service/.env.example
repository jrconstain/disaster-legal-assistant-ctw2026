# Copia este archivo como .env y agrega tu API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

# openai | mock
LLM_PROVIDER=openai

# Ruta de salida local. Puede ser relativa al repo.
OUTPUT_DIR=outputs

# Cuantas fotos como maximo se envian al modelo.
MAX_EVIDENCE_IMAGES=8
