{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctw2026.local/schemas/legal-disaster-rag-document.schema.json",
  "title": "Legal & Disaster Response RAG — Document Metadata Schema",
  "description": "Contrato de metadata para documentos jurídicos e institucionales usados en un RAG de orientación jurídica y respuesta ante desastres. El contenido canónico del documento se conserva en Markdown; este esquema define el front matter/sidecar metadata y los campos de enriquecimiento que permiten filtrar, rankear, citar y recuperar fragmentos con trazabilidad.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "title",
    "document_type",
    "source",
    "dates",
    "jurisdiction",
    "topics",
    "processing",
    "rag"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Versión del contrato de metadata."
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Identificador único y estable. No debe depender del nombre temporal del archivo."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Título oficial o título visible del documento."
    },
    "short_title": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nombre corto útil para búsqueda; null si no existe o no es inequívoco."
    },
    "document_type": {
      "type": "string",
      "enum": [
        "legal_norm",
        "jurisprudence",
        "administrative_act",
        "communique",
        "bulletin",
        "guide",
        "protocol",
        "manual",
        "faq",
        "institutional_page",
        "form",
        "call_for_applications",
        "directory",
        "report",
        "technical_sheet",
        "situation_report",
        "map",
        "other"
      ],
      "description": "Categoría documental amplia y estable para filtros y ranking."
    },
    "document_subtype": {
      "type": [
        "string",
        "null"
      ],
      "description": "Denominación más específica conservando el lenguaje de la fuente, p. ej. 'comunicado de prensa'."
    },
    "language": {
      "type": "string",
      "default": "es",
      "description": "Código ISO 639-1."
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "dates": {
      "$ref": "#/$defs/dates"
    },
    "jurisdiction": {
      "$ref": "#/$defs/jurisdiction"
    },
    "topics": {
      "$ref": "#/$defs/topics"
    },
    "event_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/event_context"
        },
        {
          "type": "null"
        }
      ],
      "description": "Contexto de evento específico cuando el documento responde a un desastre o emergencia concreta."
    },
    "legal_context": {
      "$ref": "#/$defs/legal_context"
    },
    "actionability": {
      "$ref": "#/$defs/actionability"
    },
    "content_features": {
      "$ref": "#/$defs/content_features"
    },
    "temporal_relevance": {
      "type": "string",
      "enum": [
        "permanent",
        "long_term",
        "event_specific",
        "temporary",
        "unknown"
      ],
      "description": "Relevancia temporal informativa del documento. No equivale a vigencia jurídica. Ejemplo: un comunicado posterior a un sismo puede ser event_specific aunque cite normas vigentes."
    },
    "processing": {
      "$ref": "#/$defs/processing"
    },
    "rag": {
      "$ref": "#/$defs/rag"
    }
  },
  "$defs": {
    "issuer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Entidad u órgano que emite el documento."
        },
        "entity_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "public_national",
            "public_territorial",
            "judicial",
            "legislative",
            "regulator",
            "private_association",
            "private_entity",
            "international_organization",
            "other",
            null
          ]
        },
        "source_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "normative_authority",
            "judicial_authority",
            "administrative_authority",
            "public_information_source",
            "nonstate_information_source",
            "technical_source",
            "unknown",
            null
          ],
          "description": "Rol de la entidad frente al contenido. Permite distinguir, por ejemplo, una autoridad que expide una norma de una entidad que solo la explica o cita."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "source_type"
      ],
      "properties": {
        "source_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nombre de la fuente o repositorio."
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_primary",
            "official_repository",
            "institutional_primary",
            "secondary",
            "unknown"
          ],
          "description": "Tipo de procedencia. 'institutional_primary' sirve para documentos emitidos por la propia entidad pero que no constituyen una fuente jurídica normativa."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Solo para documentos jurídicos cuando la entrada en vigencia está soportada."
        },
        "expiration_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Fecha del evento al que responde el documento, si aplica."
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ordenamiento o entidad territorial jurídicamente relevante."
        },
        "territorial_scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nacional, departamental, distrital, municipal, etc."
        },
        "geographic_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Lugares explícitamente mencionados o claramente cubiertos por el documento."
        }
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legal_areas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "subject_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "disaster_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "population_groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rights_mentioned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Solo derechos explícitos o clasificaciones inequívocas; evitar inferencias especulativas."
        },
        "benefits_or_services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "event_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "description": "Tipo de emergencia o desastre: sismo, inundación, movimiento en masa, etc."
        },
        "event_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "relation_to_event": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "prevention",
            "preparedness",
            "immediate_response",
            "post_event_guidance",
            "recovery",
            "reconstruction",
            "unknown",
            null
          ]
        }
      }
    },
    "legal_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contains_legal_text": {
          "type": "boolean",
          "description": "True si reproduce texto normativo/jurisprudencial, no solo si lo menciona."
        },
        "contains_legal_citations": {
          "type": "boolean"
        },
        "legal_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "current",
            "partially_current",
            "repealed",
            "partially_repealed",
            "suspended",
            "unconstitutional",
            "partially_unconstitutional",
            "historical",
            "unknown",
            null
          ],
          "description": "Solo corresponde al documento si este es una fuente jurídica. No usar para comunicados/guías."
        },
        "is_consolidated_text": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "legal_document": {
          "anyOf": [
            {
              "$ref": "#/$defs/legal_document"
            },
            {
              "type": "null"
            }
          ]
        },
        "legal_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legal_reference"
          }
        }
      }
    },
    "legal_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instrument_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrument_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "court": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_number": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "legal_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_text"
      ],
      "properties": {
        "citation_text": {
          "type": "string",
          "description": "Referencia tal como aparece en la fuente."
        },
        "instrument_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrument_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "article": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "quoted_legal_basis",
            "cited_legal_basis",
            "modifies",
            "modified_by",
            "adds",
            "added_by",
            "repeals",
            "repealed_by",
            "regulates",
            "regulated_by",
            "concordance",
            "other",
            "unknown",
            null
          ]
        },
        "quoted_verbatim": {
          "type": "boolean",
          "description": "True si el documento reproduce literalmente el texto citado."
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ],
          "description": "Página, sección o encabezado donde aparece la referencia."
        }
      }
    },
    "actionability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contains_actionable_guidance": {
          "type": "boolean"
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_item"
          }
        },
        "contains_deadlines": {
          "type": "boolean"
        },
        "contains_contact_information": {
          "type": "boolean"
        },
        "contains_eligibility_rules": {
          "type": "boolean"
        },
        "contains_required_documents": {
          "type": "boolean"
        }
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "Acción expresamente indicada o clasificación conservadora de una instrucción de la fuente."
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Conservar literalmente plazos como 'dos a cinco años'; no simplificar."
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sitio web, teléfono, aseguradora, administrador, alcaldía, etc."
        },
        "basis_type": {
          "type": "string",
          "enum": [
            "explicit_legal_text",
            "quoted_legal_text",
            "institutional_guidance",
            "technical_guidance",
            "unknown"
          ],
          "description": "Evita confundir una recomendación institucional con una obligación jurídica."
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "content_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contains_tables": {
          "type": "boolean"
        },
        "contains_figures": {
          "type": "boolean"
        },
        "contains_forms": {
          "type": "boolean"
        },
        "contains_contact_blocks": {
          "type": "boolean"
        },
        "cross_page_tables": {
          "type": "boolean"
        },
        "has_annexes": {
          "type": "boolean"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "quality"
      ],
      "properties": {
        "method": {
          "type": "string",
          "description": "Ej.: extracción PDF + inspección visual de tablas."
        },
        "quality": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "ocr_used": {
          "type": "boolean"
        },
        "visual_inspection_used": {
          "type": "boolean",
          "description": "Debe ser true cuando tablas/diagramas requieren inspección visual para reconstrucción."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_format",
        "chunking_strategy"
      ],
      "properties": {
        "canonical_format": {
          "type": "string",
          "const": "markdown",
          "description": "El cuerpo canónico del documento se conserva en Markdown."
        },
        "chunking_strategy": {
          "type": "string",
          "enum": [
            "semantic_hierarchy"
          ],
          "description": "Chunking posterior por estructura semántica, no por longitud fija."
        },
        "preferred_chunk_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "article",
              "paragraph",
              "section",
              "numbered_item",
              "table_row",
              "procedure",
              "definition",
              "faq_item",
              "contact_block"
            ]
          },
          "uniqueItems": true
        },
        "inherit_metadata_to_chunks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Campos que deberían propagarse a cada chunk para recuperación y citas."
        },
        "preserve_source_attribution": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
